# Core
NODE_ENV=production
DATABASE_URL=postgresql://user:pass@db-host:5432/db_evoluihub

# Auth / Cookies
AUTH_JWT_SECRET=change_me_to_a_strong_secret
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=seudominio.com
AUTH_COOKIE_SAMESITE=none
ALLOWED_ORIGINS=https://admin.seudominio.com,https://app.seudominio.com
AUTH_ALLOW_DEV_HEADERS=false

# Email Relay
EMAIL_RELAY_URL=https://relay.example.com/send
EMAIL_RELAY_API_KEY=your-api-key
EMAIL_FROM_EMAIL=evoluihub@seudominio.com
EMAIL_FROM_NAME=EvoluiHub

# Admin app URL (para links de reset/convite)
ADMIN_APP_URL=https://admin.seudominio.com

# Worker
WORKER_OUTBOX_INTERVAL_MS=10000
WORKER_OUTBOX_BATCH=10

# Defaults
TENANT_ID=1
ADMIN_USER_ID=admin-root
